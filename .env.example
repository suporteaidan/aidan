# Public build-time settings. Never add passwords, JWTs, API keys, or OAuth secrets.
# true = original Aidan showcase with demo data and interactions.
# false = real email/password API login and registration.
EXPO_PUBLIC_USE_MOCKS=true

# Web on the same host: http://localhost:8000
# Physical Android: use reachable HTTPS or your PC's LAN IP (e.g. http://192.168.1.20:8000).
# Android emulator: http://10.0.2.2:8000
# Never use localhost for Android on a physical phone to reach your PC.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=12000
EXPO_PUBLIC_API_HEALTH_PATH=/health
