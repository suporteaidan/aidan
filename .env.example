# Variáveis EXPO_PUBLIC_* são incorporadas ao bundle e são PÚBLICAS.
# Nunca coloque senhas, tokens privados ou chaves de serviço aqui.

# Enquanto a API ainda não estiver integrada, usar dados mockados.
EXPO_PUBLIC_USE_MOCKS=true

# Quando o backend estiver disponível, defina a URL real.
# Android físico: IP LAN do computador ou um HTTPS acessível ao celular.
# Emulador Android: http://10.0.2.2:8000 (se a API rodar na porta 8000 da máquina).
# Expo Web no mesmo PC: http://localhost:8000 (com CORS configurado).
EXPO_PUBLIC_API_URL=

# Caminho de health check é sugestão, NÃO endpoint confirmado do Backend-Aidan.
EXPO_PUBLIC_API_HEALTH_PATH=/health
EXPO_PUBLIC_API_TIMEOUT_MS=12000
